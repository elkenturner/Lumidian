# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_32_plus_char_random_secret

# ── Database ──────────────────────────────────────────────────────────────────
# Railway: use a volume mount and set this to the mount path
DATABASE_URL=sqlite+aiosqlite:///./clarity_ai.db

# ── LLM API Keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── Search ────────────────────────────────────────────────────────────────────
SERPER_API_KEY=your_serper_key_here  # https://serper.dev — 2,500 free searches/month

# ── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ── Email (Resend HTTP API) ───────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key  # https://resend.com — uses HTTPS, no SMTP ports needed
EMAIL_FROM=Lumidian <noreply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com  # receives in-app support form submissions

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production  # set to "production" to enable secure cookies

# ── Admin Account (seeded on first startup) ───────────────────────────────────
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_NAME=Admin
